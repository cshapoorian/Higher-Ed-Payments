PORT=4000
DATABASE_URL="file:./dev.db"

# Comma-separated list of allowed web-app origins once hosted, e.g.
# https://storefront.example.edu. Leave as * for local dev only.
# An entry starting with "*" matches by suffix instead of exact-equal — e.g.
# on Netlify, "*--your-site.netlify.app" allows that site's deploy-preview
# and branch-deploy subdomains without opening CORS to all of netlify.app.
CORS_ORIGIN=*

# Hyperswitch sandbox — https://dashboard.hyperswitch.io
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io
HYPERSWITCH_SECRET_KEY=snd_xxx
HYPERSWITCH_PUBLISHABLE_KEY=pk_snd_xxx
# Dashboard: the merchant_id shown in Settings, also echoed on every payment
# response. Not a secret. Used only by GET /api/payment-capabilities to read
# which connectors are wired up, so the storefront can tell a student that
# ACH is unavailable *because of the account* rather than guessing. Leave it
# unset and ACH availability falls back to "unknown".
HYPERSWITCH_MERCHANT_ID=merchant_xxx
# Dashboard: Developer -> Payment Settings -> Webhooks -> "Payment response
# hash key". Signs incoming webhooks (HMAC-SHA512 over the raw JSON body).
HYPERSWITCH_PAYMENT_RESPONSE_HASH_KEY=xxx
